-- ============================================================================
-- TAPSLOG PHASE 2 SCHEMA MIGRATION SCRIPT
-- Target: PostgreSQL 14+ / Supabase PostgreSQL
-- Features: Google Classroom Course Model, NFC Card Locking, Co-Teachers,
--           RSO Memberships, Attendance Logs, and User Preferences
-- ============================================================================

-- Enable UUID extension if not already available
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- ----------------------------------------------------------------------------
-- 1. USERS TABLE
-- Core authentication table supporting Student, Teacher, and Admin roles.
-- Includes preference flag for RSO badge visibility.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS users (
    user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    role VARCHAR(20) NOT NULL CHECK (role IN ('STUDENT', 'TEACHER', 'ADMIN')),
    show_rso_badge_publicly BOOLEAN NOT NULL DEFAULT true,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);
CREATE INDEX IF NOT EXISTS idx_users_role ON users(role);

-- ----------------------------------------------------------------------------
-- 2. TEACHERS PROFILE TABLE
-- Faculty demographic & department profile.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS teachers (
    teacher_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID UNIQUE NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    faculty_id VARCHAR(50) UNIQUE NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    department VARCHAR(100) NOT NULL DEFAULT 'College of Information Technology',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_teachers_user_id ON teachers(user_id);
CREATE INDEX IF NOT EXISTS idx_teachers_faculty_id ON teachers(faculty_id);

-- ----------------------------------------------------------------------------
-- 3. STUDENTS PROFILE TABLE
-- Student demographic, academic degree program, and year level.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS students (
    student_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID UNIQUE NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    student_number VARCHAR(50) UNIQUE NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    program VARCHAR(100) NOT NULL,
    year_level VARCHAR(20) NOT NULL DEFAULT '1st Year',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_students_user_id ON students(user_id);
CREATE INDEX IF NOT EXISTS idx_students_number ON students(student_number);

-- ----------------------------------------------------------------------------
-- 4. NFC CARDS TABLE (Hardware Identity Locking)
-- Strictly enforces: 1 Physical NFC Card = 1 Immutable Account.
-- Uses AES-256-GCM cipher payload + SHA-256 card_uid_hash for fast collision check.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS nfc_cards (
    card_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID UNIQUE REFERENCES students(student_id) ON DELETE CASCADE,
    teacher_id UUID UNIQUE REFERENCES teachers(teacher_id) ON DELETE CASCADE,
    encrypted_card_uid TEXT NOT NULL,
    iv VARCHAR(64) NOT NULL,
    auth_tag VARCHAR(64) NOT NULL,
    card_uid_hash VARCHAR(64) UNIQUE NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'REVOKED', 'LOST')),
    registered_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT chk_card_owner CHECK (
        (student_id IS NOT NULL AND teacher_id IS NULL) OR
        (teacher_id IS NOT NULL AND student_id IS NULL)
    )
);

CREATE INDEX IF NOT EXISTS idx_nfc_cards_uid_hash ON nfc_cards(card_uid_hash);
CREATE INDEX IF NOT EXISTS idx_nfc_cards_status ON nfc_cards(status);

-- ----------------------------------------------------------------------------
-- 5. COURSES TABLE
-- Subject/Section course model with room assignment and 6-char Join Code.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS courses (
    course_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    course_code VARCHAR(50) NOT NULL,
    course_name VARCHAR(200) NOT NULL,
    section VARCHAR(50) NOT NULL,
    room_assignment VARCHAR(100) NOT NULL DEFAULT 'TBD',
    join_code VARCHAR(20) UNIQUE NOT NULL,
    is_join_locked BOOLEAN NOT NULL DEFAULT false,
    created_by UUID NOT NULL REFERENCES teachers(teacher_id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_courses_join_code ON courses(join_code);
CREATE INDEX IF NOT EXISTS idx_courses_created_by ON courses(created_by);

-- ----------------------------------------------------------------------------
-- 6. COURSE TEACHERS MAPPING TABLE (Co-Teacher / Dean / Observer Support)
-- Implements Google Classroom multi-instructor architecture.
-- Option A1 (Read-Only Observer): Only PRIMARY acts as the active NFC scanner.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS course_teachers (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    course_id UUID NOT NULL REFERENCES courses(course_id) ON DELETE CASCADE,
    teacher_id UUID NOT NULL REFERENCES teachers(teacher_id) ON DELETE CASCADE,
    role VARCHAR(20) NOT NULL DEFAULT 'CO_TEACHER' CHECK (role IN ('PRIMARY', 'CO_TEACHER', 'OBSERVER')),
    joined_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_course_teacher UNIQUE (course_id, teacher_id)
);

CREATE INDEX IF NOT EXISTS idx_course_teachers_course ON course_teachers(course_id);
CREATE INDEX IF NOT EXISTS idx_course_teachers_teacher ON course_teachers(teacher_id);

-- ----------------------------------------------------------------------------
-- 7. COURSE ENROLLMENTS TABLE (Student Class Rosters)
-- Maps enrolled students to courses via Join Code or direct roster import.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS course_enrollments (
    enrollment_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    course_id UUID NOT NULL REFERENCES courses(course_id) ON DELETE CASCADE,
    student_id UUID NOT NULL REFERENCES students(student_id) ON DELETE CASCADE,
    enrolled_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'DROPPED')),
    CONSTRAINT uq_course_enrollment UNIQUE (course_id, student_id)
);

CREATE INDEX IF NOT EXISTS idx_course_enrollments_course ON course_enrollments(course_id);
CREATE INDEX IF NOT EXISTS idx_course_enrollments_student ON course_enrollments(student_id);

-- ----------------------------------------------------------------------------
-- 8. ATTENDANCE SESSIONS TABLE
-- Represents a single scheduled or live class attendance session.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS attendance_sessions (
    session_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    course_id UUID REFERENCES courses(course_id) ON DELETE SET NULL,
    teacher_id UUID NOT NULL REFERENCES teachers(teacher_id) ON DELETE CASCADE,
    room VARCHAR(100),
    title VARCHAR(200) NOT NULL,
    scheduled_start TIMESTAMPTZ NOT NULL,
    scheduled_end TIMESTAMPTZ NOT NULL,
    teacher_time_in TIMESTAMPTZ,
    teacher_time_out TIMESTAMPTZ,
    status VARCHAR(20) NOT NULL DEFAULT 'SCHEDULED' CHECK (status IN ('SCHEDULED', 'ACTIVE', 'CLOSED')),
    is_early_dismissal BOOLEAN NOT NULL DEFAULT false,
    late_threshold_minutes INT NOT NULL DEFAULT 15,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_attendance_sessions_course ON attendance_sessions(course_id);
CREATE INDEX IF NOT EXISTS idx_attendance_sessions_teacher ON attendance_sessions(teacher_id);
CREATE INDEX IF NOT EXISTS idx_attendance_sessions_status ON attendance_sessions(status);

-- ----------------------------------------------------------------------------
-- 9. ATTENDANCE LOGS TABLE (Tap Stream & Historic Audit)
-- Records individual student card taps and timestamps.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS attendance_logs (
    log_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    session_id UUID NOT NULL REFERENCES attendance_sessions(session_id) ON DELETE CASCADE,
    student_id UUID NOT NULL REFERENCES students(student_id) ON DELETE CASCADE,
    card_id UUID REFERENCES nfc_cards(card_id) ON DELETE SET NULL,
    scanned_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    status VARCHAR(20) NOT NULL CHECK (status IN ('PRESENT', 'LATE', 'ABSENT', 'COMPLETED')),
    scan_result VARCHAR(50) NOT NULL DEFAULT 'SUCCESS',
    message TEXT,
    CONSTRAINT uq_session_student_status UNIQUE (session_id, student_id, status)
);

CREATE INDEX IF NOT EXISTS idx_attendance_logs_session ON attendance_logs(session_id);
CREATE INDEX IF NOT EXISTS idx_attendance_logs_student ON attendance_logs(student_id);
CREATE INDEX IF NOT EXISTS idx_attendance_logs_scanned_at ON attendance_logs(scanned_at);

-- ----------------------------------------------------------------------------
-- 10. RSO ENTITIES TABLE
-- Recognized Student Organizations registered at the university.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS rso_entities (
    rso_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(200) NOT NULL,
    acronym VARCHAR(50) UNIQUE NOT NULL,
    description TEXT,
    logo_url TEXT,
    category VARCHAR(100) DEFAULT 'Academic Organization',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_rso_acronym ON rso_entities(acronym);

-- ----------------------------------------------------------------------------
-- 11. RSO MEMBERSHIPS TABLE
-- Connects Users (Students & Faculty Advisers) to their RSO entities.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS rso_memberships (
    membership_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rso_id UUID NOT NULL REFERENCES rso_entities(rso_id) ON DELETE CASCADE,
    user_id UUID NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    position VARCHAR(100) NOT NULL DEFAULT 'Member',
    is_active BOOLEAN NOT NULL DEFAULT true,
    joined_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_user_rso UNIQUE (rso_id, user_id)
);

CREATE INDEX IF NOT EXISTS idx_rso_memberships_user ON rso_memberships(user_id);
CREATE INDEX IF NOT EXISTS idx_rso_memberships_rso ON rso_memberships(rso_id);

-- ----------------------------------------------------------------------------
-- 12. SEED DATA (Default RSO Entities)
-- Seed standard organizations for testing student/faculty profile badges.
-- ----------------------------------------------------------------------------
INSERT INTO rso_entities (rso_id, name, acronym, description, category)
